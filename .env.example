# اتصال قاعدة بيانات MySQL
# احصل على هذه البيانات من hPanel > Databases، وفعّل "Remote MySQL" للوصول إليها من الخارج (Vercel)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME?connection_limit=5&pool_timeout=20"

# مفتاح تشفير الجلسات - أنشئه عشوائياً، مثال:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=""

# رابط الموقع المنشور (في بيئة الإنتاج على Vercel)
NEXTAUTH_URL="https://your-project.vercel.app"

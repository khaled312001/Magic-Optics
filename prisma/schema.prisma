// Magic Optics — مركز ماجيك للبصريات
// Database schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// المستخدمون (موظفو المحل)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // صاحب المحل / مدير
  EMPLOYEE // موظف
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  username          String   @unique
  password          String
  role              Role     @default(EMPLOYEE)
  active            Boolean  @default(true)
  // صلاحيات دقيقة للموظفين (المدير دائماً لديه كل الصلاحيات بغض النظر عن هذه القيم)
  canEditInventory  Boolean  @default(true) // تعديل/إضافة أصناف المخزون وتسوية الكميات
  canManageExpenses Boolean  @default(true) // تسجيل حركات "منصرف" بالخزنة (مصروفات/مشتريات/سحب)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders           Order[]
  payments         Payment[]
  cashEntries      CashEntry[]
  stockMoves       StockMovement[]
  prescriptions    Prescription[]
  stockCounts      StockCount[]
  loginLogs        LoginLog[]
  cashRegisterDays CashRegisterDay[]

  @@map("users")
}

// سجل تسجيلات الدخول (للسجل اليومي - متابعة نشاط الموظفين)
model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

// ---------------------------------------------------------------------------
// العملاء والكشوفات الطبية
// ---------------------------------------------------------------------------

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  phone2    String?
  address   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]
  orders        Order[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

// كشف النظر: مقاسات العدسات لكل عين (بعيد / قريب) + المسافة بين الحدقتين
model Prescription {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())

  // بعيد (Distance)
  rightSphFar  Float?
  rightCylFar  Float?
  rightAxisFar Int?
  leftSphFar   Float?
  leftCylFar   Float?
  leftAxisFar  Int?

  // قريب (Reading)
  rightSphNear  Float?
  rightCylNear  Float?
  rightAxisNear Int?
  leftSphNear   Float?
  leftCylNear   Float?
  leftAxisNear  Int?

  ipdFar  Float? // المسافة بين الحدقتين - بعيد
  ipdNear Float? // المسافة بين الحدقتين - قريب
  notes   String? @db.Text

  // بيانات ورقة الكشف المطبوعة
  doctorName String? @db.VarChar(150) // اسم الطبيب
  frame      String? @db.VarChar(200) // الفريم
  lensType   String? @db.VarChar(200) // نوع العدسات

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  orders Order[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("prescriptions")
}

// ---------------------------------------------------------------------------
// المخزون: إطارات (طبية / شمسية)، عدسات، إكسسوارات
// ---------------------------------------------------------------------------

enum ProductCategory {
  FRAME_MEDICAL // اطار نظارة طبية
  FRAME_SUNGLASSES // اطار نظارة شمسية
  LENS // عدسة
  LENS_CONTRACT // عدسات التعاقد (قائمة أسعار سيلفر/بلاتينيوم درجة أولى وثانية - منفصلة عن العدسات العادية)
  ACCESSORY // اكسسوار
}

model Product {
  id          Int             @id @default(autoincrement())
  code        String? // كود الصنف فى كتالوج المحل
  factoryCode String? // كود المصنع / المورد
  name        String // النوع / الاسم
  category    ProductCategory
  costPrice   Decimal         @db.Decimal(10, 2) // سعر التكلفة
  sellPrice   Decimal         @db.Decimal(10, 2) // سعر البيع
  quantity    Int             @default(0)
  minQuantity Int             @default(3) // حد التنبيه عند قرب النفاذ
  notes       String?         @db.Text
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems      OrderItem[]
  stockMovements  StockMovement[]
  stockCountItems StockCountItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

enum StockMovementType {
  IN // إضافة للمخزون (توريد)
  OUT // خصم من المخزون (بيع / تالف)
  ADJUSTMENT // تسوية جرد
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  productId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  note        String?
  createdById Int?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// الفواتير / الطلبات
// ---------------------------------------------------------------------------

enum OrderType {
  MEDICAL // نظارة طبية
  SUNGLASSES // نظارة شمسية
  LENS_CHANGE // تغيير عدسات
  OTHER // أخرى
}

enum OrderStatus {
  PENDING // قيد التجهيز
  READY // جاهزة للاستلام
  DELIVERED // تم التسليم
  CANCELLED // ملغية
}

model Order {
  id             Int           @id @default(autoincrement())
  receiptNumber  String        @unique // رقم الإيصال
  customerId     Int?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  prescriptionId Int?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  type   OrderType   @default(MEDICAL)
  status OrderStatus @default(PENDING)

  totalAmount Decimal @db.Decimal(10, 2)
  paidAmount  Decimal @default(0) @db.Decimal(10, 2)

  deliveryDate DateTime?
  notes        String?   @db.Text

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String // وصف الصنف (يُستخدم أيضاً عند عدم الربط بمنتج من المخزون)
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  note        String?
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  cashEntry CashEntry? // كل دفعة تدخل الخزنة تلقائياً كحركة وارد

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// حركة الخزنة اليومية
// ---------------------------------------------------------------------------

enum CashCategory {
  SUNGLASSES_SALE // مبيعات شمس
  MEDICAL_SALE // مبيعات نظر
  LENS_CHANGE // تغيير عدسات
  OTHER_SALE // مبيعات أخرى
  SUNGLASSES_PURCHASE // مشتريات شمس
  MEDICAL_PURCHASE // مشتريات نظارات
  LENS_PURCHASE // مشتريات عدسات
  OTHER_PURCHASE // مشتريات أخرى
  BANK_DEPOSIT // إيداع بنك
  EXPENSE // مصروفات
  WITHDRAWAL // سحب / مرتبات
  OTHER // أخرى
  DAY_CLOSING // إقفال اليوم - تسليم النقدية وتصفير الخزنة
  MONTH_CLOSING // إقفال الشهر - تسليم النقدية وتصفير الخزنة
}

enum CashEntryType {
  IN
  OUT
}

enum CashCloseScope {
  DAY
  MONTH
}

model CashRegisterDay {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique @db.Date
  openingBalance Decimal  @default(0) @db.Decimal(10, 2)
  closed         Boolean  @default(false)
  createdAt      DateTime @default(now())

  // بيانات الإقفال (لسجل الإقفالات) - closedById فاضي مع closed = إقفال تلقائي
  closedAt   DateTime?
  closeScope CashCloseScope?
  closedById Int?
  closedBy   User?           @relation(fields: [closedById], references: [id], onDelete: SetNull)

  entries CashEntry[]

  @@map("cash_register_days")
}

model CashEntry {
  id          Int             @id @default(autoincrement())
  dayId       Int
  day         CashRegisterDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  category    CashCategory
  type        CashEntryType
  amount      Decimal         @db.Decimal(10, 2)
  note        String?
  createdById Int?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  // حركة وارد مولّدة من دفعة فاتورة (تُحذف مع الدفعة)
  paymentId Int?     @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@map("cash_entries")
}

// ---------------------------------------------------------------------------
// إعدادات المحل
// ---------------------------------------------------------------------------

enum AutoCloseMode {
  NONE // يدوي فقط
  DAILY // كل يوم الساعة 12 بالليل
  MONTHLY // آخر يوم فى كل شهر
}

model ShopSettings {
  id              Int           @id @default(1)
  name            String        @default("Magic Optics - مركز ماجيك للبصريات")
  address         String        @default("قنا - قفط - أمام فرع اتصالات")
  phone           String        @default("01012135456")
  phone2          String?
  commercialRegister String?    @db.VarChar(50) // رقم السجل التجاري (يُطبع على الفاتورة)
  taxNumber       String?       @db.VarChar(50) // رقم البطاقة الضريبية (يُطبع على الفاتورة)
  examFee         Decimal       @default(50) @db.Decimal(10, 2) // سعر كشف نظر العدسات على الفاتورة
  discountPercent Decimal       @default(20) @db.Decimal(5, 2) // نسبة خصم الشنابر (الإطارات) المطبوعة أسفل الفاتورة
  autoClose       AutoCloseMode @default(NONE) // الإقفال التلقائي للخزنة

  @@map("shop_settings")
}

// ---------------------------------------------------------------------------
// التقارير الشهرية (تُنشأ تلقائياً فى نهاية كل شهر)
// ---------------------------------------------------------------------------

model MonthlyReport {
  id             Int      @id @default(autoincrement())
  year           Int
  month          Int // 1-12
  revenue        Decimal  @db.Decimal(12, 2)
  cost           Decimal  @db.Decimal(12, 2) // تكلفة البضاعة المباعة
  expenses       Decimal  @db.Decimal(12, 2) // مصروفات/سحب من الخزنة
  netProfit      Decimal  @db.Decimal(12, 2)
  collected      Decimal  @default(0) @db.Decimal(12, 2) // المحصّل فعلياً خلال الشهر
  outstanding    Decimal  @default(0) @db.Decimal(12, 2) // المتبقي عند العملاء من فواتير الشهر
  // لقطة المخزون وقت إقفال الشهر
  stockQuantity  Int      @default(0) // عدد القطع
  stockCostValue Decimal  @default(0) @db.Decimal(12, 2) // قيمة المخزون بسعر التكلفة
  stockSellValue Decimal  @default(0) @db.Decimal(12, 2) // قيمة المخزون بسعر البيع
  generatedAt    DateTime @default(now())

  @@unique([year, month])
  @@map("monthly_reports")
}

enum StockCountStatus {
  OPEN // جاري العد
  APPROVED // معتمد - تمت تسوية المخزون
}

/// جرد البضاعة: لقطة من المخزون وقت البدء، يُكتب أمام كل صنف العدد الفعلي ثم يُعتمد
model StockCount {
  id          Int              @id @default(autoincrement())
  title       String
  status      StockCountStatus @default(OPEN)
  notes       String?          @db.Text
  createdById Int?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  approvedAt  DateTime?

  items StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id         Int             @id @default(autoincrement())
  countId    Int
  count      StockCount      @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  Int?
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  code       String?
  category   ProductCategory
  systemQty  Int // الكمية بالسيستم وقت بدء الجرد
  countedQty Int? // الكمية الفعلية (فاضية = لم يُعد بعد)
  costPrice  Decimal         @db.Decimal(10, 2)
  sellPrice  Decimal         @db.Decimal(10, 2)

  @@index([countId])
  @@map("stock_count_items")
}
